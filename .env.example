# Comma-separated; generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ICAL_MCP_API_KEY=
ICAL_MCP_PORT=8765
# 1 = also accept the key in the URL (/k/<KEY>/mcp, ?api_key=). Default: header only.
ICAL_MCP_ALLOW_URL_KEY=0
# Seconds to wait for open connections on Ctrl+C before cancelling them.
ICAL_MCP_SHUTDOWN_TIMEOUT=5
# Read backend for list_calendars/get_events: icalbuddy (default) or osascript (JXA + EventKit, no icalbuddy needed).
ICAL_MCP_READ_BACKEND=icalbuddy
